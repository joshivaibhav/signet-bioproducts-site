---
import ButtonLink from "../components/ButtonLink.astro";
import ProductSketch from "../components/ProductSketch.astro";
import { quoteHref, samplesHref } from "../config/navigation";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";

// TODO(copy): product names and blurbs are placeholders until product content exists.
const products = [
  { kind: "bag", name: "Bags", blurb: "Take-out and delivery bags" },
  { kind: "cup", name: "Cups", blurb: "Hot and cold cups with lids" },
  { kind: "container", name: "Containers", blurb: "Clamshells and food boxes" },
  { kind: "plate", name: "Plates", blurb: "Plates and bowls" },
] as const;
---

<BaseLayout>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-24">
    <h1 class="max-w-3xl text-5xl leading-[1.05] font-bold tracking-tight sm:text-7xl">
      {site.tagline}
    </h1>
    <!-- TODO(copy): intro paragraph. Keep it free of environmental claims unless backed by product data. -->
    <p class="mt-6 max-w-xl text-lg leading-relaxed">
      Bags, cups, containers and plates for take-out, delivery and dine-in, with
      custom printing for your brand. Tell us what you need and we'll send a
      quote or samples.
    </p>
    <div class="mt-8 flex flex-wrap gap-3">
      <ButtonLink href={quoteHref}>Request a quote</ButtonLink>
      <ButtonLink href={samplesHref} variant="secondary">
        Request samples
      </ButtonLink>
    </div>
  </section>

  <section
    aria-labelledby="products-heading"
    class="mx-auto mt-20 max-w-6xl px-4 sm:mt-28 sm:px-6"
  >
    <h2 id="products-heading" class="text-2xl font-bold tracking-tight">
      What we make
    </h2>
    <ul class="mt-8 grid grid-cols-2 border-t border-l border-line lg:grid-cols-4">
      {products.map((product) => (
        <li class="border-r border-b border-line">
          <a href="/products" class="group block p-6 hover:bg-sage sm:p-8">
            <ProductSketch
              kind={product.kind}
              class="h-28 w-28 text-ink sm:h-32 sm:w-32"
            />
            <h3 class="mt-4 text-xl font-semibold group-hover:underline">
              {product.name}
            </h3>
            <p class="mt-1 text-sm">{product.blurb}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto mt-20 max-w-6xl px-4 sm:mt-28 sm:px-6">
    <div class="flex flex-col gap-6 rounded-2xl bg-ink p-8 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-12">
      <div>
        <h2 class="text-3xl font-bold tracking-tight">
          Put your brand on every order
        </h2>
        <!-- TODO(copy): confirm printing options. -->
        <p class="mt-2 max-w-lg text-paper/80">
          We can print your logo on bags, cups and containers.
        </p>
      </div>
      <a
        href="/custom-printing"
        class="inline-flex shrink-0 items-center justify-center rounded-full bg-paper px-5 py-2.5 text-sm font-semibold text-ink transition-colors hover:bg-sage"
      >
        See custom printing
      </a>
    </div>
  </section>
</BaseLayout>
