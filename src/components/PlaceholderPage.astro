---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<BaseLayout title={title}>
  <section class="mx-auto max-w-6xl px-4 pt-16 sm:px-6 sm:pt-24">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">{title}</h1>
    <div class="mt-6 max-w-prose text-lg leading-relaxed">
      <slot />
    </div>
  </section>
</BaseLayout>
