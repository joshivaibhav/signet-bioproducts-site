---
import { site } from "../config/site";
import { mainNav } from "../config/navigation";

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-sage">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[2fr_1fr] md:items-start">
    <div class="space-y-3">
      <p class="font-display text-xl font-bold">{site.name}</p>
      <p class="max-w-sm text-sm">{site.tagline}</p>
      <p class="text-sm">
        <a
          href={`mailto:${site.contactEmail}`}
          class="font-medium text-moss underline underline-offset-4"
        >
          {site.contactEmail}
        </a>
      </p>
    </div>

    <nav aria-label="Footer">
      <ul class="grid gap-2 text-sm">
        {mainNav.map((item) => (
          <li>
            <a href={item.href} class="hover:underline">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <p class="mx-auto max-w-6xl px-4 py-5 text-xs sm:px-6">
      © {year} {site.name}
    </p>
  </div>
</footer>
