---
interface Props {
  href: string;
  variant?: "primary" | "secondary";
  class?: string;
}

const { href, variant = "primary", class: className } = Astro.props;

const variants = {
  primary: "bg-ink text-paper hover:bg-moss",
  secondary: "border border-ink text-ink hover:bg-sage",
};
---

<a
  href={href}
  class:list={[
    "inline-flex items-center justify-center rounded-full px-5 py-2.5 text-sm font-semibold transition-colors",
    variants[variant],
    className,
  ]}
>
  <slot />
</a>
