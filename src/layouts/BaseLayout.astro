---
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import RobotsMeta from "../components/RobotsMeta.astro";
import { site } from "../config/site";
import "../styles/global.css";

interface Props {
  /** Page title. Omit on the home page to use the site name alone. */
  title?: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : site.name;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <RobotsMeta />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-10 focus:bg-paper focus:px-4 focus:py-2"
    >
      Skip to content
    </a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
